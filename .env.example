# ─── Elenor website — environment variables ────────────────────────────────
# Copy to .env.local for local development and set the same keys in
# Netlify → Site configuration → Environment variables for production.

# Public URL of the site (canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://elenorr.netlify.app

# Supabase — stores enquiries, notify-me requests and newsletter sign-ups
# (shown in the /admin inbox)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email — every enquiry is emailed to the studio inbox over SMTP.
# Gmail: SMTP_USER is the Gmail address and SMTP_PASS a 16-character
# App Password (Google Account → Security → 2-Step Verification → App passwords).
# Other providers: also set SMTP_HOST / SMTP_PORT (587 uses STARTTLS).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=            # defaults to SMTP_USER
# Recipient of enquiry emails (defaults to xyz@gmail.com)
# ENQUIRY_NOTIFY_TO=

# Secret used to sign admin console sessions (32+ random characters).
# Required in production: admin sign-in is disabled without it.
ADMIN_JWT_SECRET=

# Optional: webhook (e.g. n8n) notified on every new enquiry / sign-up
N8N_WEBHOOK_URL=

# Optional: official Instagram profile. Social links stay hidden until set.
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional: overrides the studio WhatsApp number (+91 99243 96959)
# NEXT_PUBLIC_WHATSAPP_NUMBER=
